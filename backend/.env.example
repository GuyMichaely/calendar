# Copy to .local/backend.env. This is backend-only; never use VITE_ for secrets.
CALENDAR_APP_URL=https://guymichaely.com/calendar/
CALENDAR_PUBLIC_BASE_URL=https://calendar-sync.guymichaely.com/
GOOGLE_CLIENT_ID=REPLACE
GOOGLE_CLIENT_SECRET=REPLACE
ALLOWED_GOOGLE_SUBJECT=REPLACE

# Optional additional frontend URLs for CORS and post-login return destinations.
# CALENDAR_ADDITIONAL_APP_URLS_JSON=["http://127.0.0.1:5177/calendar/","http://localhost:5177/calendar/"]
