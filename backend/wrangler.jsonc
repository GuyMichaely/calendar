{
  // The calendar at calendar.guymichaely.com: its built files, and the sync server under /sync.
  // The name stays calendar-sync so the stored calendar (its Durable Object) carries over. See README.md.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "calendar-sync",
  "main": "worker.js",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "33fbeec446845ec831132810ae18aab5",
  "routes": [{ "pattern": "calendar.guymichaely.com", "custom_domain": true }],
  // Access guards the custom domain only, so the workers.dev and preview addresses stay off.
  "workers_dev": false,
  "preview_urls": false,
  // Everything is the app's files (dist, built first) except /sync, which runs the Worker.
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": ["/sync", "/sync/*"] },
  "durable_objects": { "bindings": [{ "name": "CALENDAR", "class_name": "CalendarStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CalendarStore"] }],
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "calendar-sync-attachments" }],
  "observability": { "enabled": false }
}
