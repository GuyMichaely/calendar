#!/usr/bin/env bash
# Pinned, repository-local runtime; no global installs or shell profile changes.
set -euo pipefail
cd "$(dirname "$0")/.."
version=$(cat .bun-version)
runtime="$PWD/.local/bin/bun"
if [[ ! -x "$runtime" ]] || [[ "$("$runtime" --version)" != "$version" ]]; then
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) platform=linux-x64 ;;
    Linux-aarch64) platform=linux-aarch64 ;;
    Darwin-x86_64) platform=darwin-x64 ;;
    Darwin-arm64) platform=darwin-aarch64 ;;
    *) echo 'Use the container workflow on this platform.' >&2; exit 1 ;;
  esac
  archive="bun-$platform.zip"
  mkdir -p .local/downloads .local/bin
  curl --fail --location --retry 3 "https://github.com/oven-sh/bun/releases/download/bun-v$version/$archive" -o ".local/downloads/$archive"
  expected=$(awk -v file="$archive" '$2 == file {print $1}' scripts/bun-checksums.txt)
  [[ -n "$expected" ]] || { echo "Missing pinned checksum for $archive" >&2; exit 1; }
  if command -v sha256sum >/dev/null; then
    actual=$(sha256sum ".local/downloads/$archive")
  else
    actual=$(shasum -a 256 ".local/downloads/$archive")
  fi
  [[ "${actual%% *}" == "$expected" ]] || { echo 'Bun checksum mismatch' >&2; exit 1; }
  unzip -oq ".local/downloads/$archive" -d .local/downloads
  cp ".local/downloads/bun-$platform/bun" "$runtime"
fi
export BUN_INSTALL_CACHE_DIR="$PWD/.local/cache/bun"
export BUN_INSTALL_GLOBAL_DIR="$PWD/.local/global"
export BUN_INSTALL_BIN="$PWD/.local/bin"
export XDG_CACHE_HOME="$PWD/.local/cache"
export TMPDIR="$PWD/.local/tmp"
export PATH="$PWD/.local/bin:$PATH"
mkdir -p "$TMPDIR"
exec "$runtime" --no-env-file "$@"
