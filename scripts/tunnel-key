#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
umask 077
mkdir -p .local/ssh
key=.local/ssh/localhost-run
if [[ ! -f "$key" ]]; then
  ssh-keygen -q -t ed25519 -N '' -C calendar-localhost-run -f "$key"
fi
echo 'Register this PUBLIC key at https://admin.localhost.run/ (never upload the file without .pub):'
cat "$key.pub"
