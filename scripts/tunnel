#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
umask 077
mkdir -p .local/ssh
identity=(-o IdentityFile=none)
user=nokey
if [[ -f .local/ssh/localhost-run ]] && [[ "${1:-}" != --anonymous ]]; then
  identity=(-i "$PWD/.local/ssh/localhost-run")
  user=calendar
fi
echo 'Keep this process running. Register the printed HTTPS URL plus /auth/callback/google with your OAuth provider.'
echo 'Set CALENDAR_PUBLIC_BASE_URL in .local/backend.env to that URL, then recreate the backend container.'
exec ssh -F /dev/null \
  -o BatchMode=yes -o IdentityAgent=none -o IdentitiesOnly=yes "${identity[@]}" \
  -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$PWD/.local/ssh/known_hosts" \
  -o ConnectTimeout=15 -o ExitOnForwardFailure=yes \
  -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
  -T -R 80:127.0.0.1:8787 "$user@localhost.run" -- --output text
