  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "jsdom": "30.0.1",
    "svelte-check": "4.7.6",
    "typescript": "~6.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
