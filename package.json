{
  "name": "calendar",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "start": "bun backend/bun-server.js",
    "test": "bun test ./tests",
    "dev:solid": "vite --config solid/vite.config.ts",
    "dev:backend": "bun backend/bun-dev.js",
    "start:backend": "bun backend/bun-server.js",
    "test:solid": "bun test ./solid/test",
    "typecheck:solid": "tsc -p solid/tsconfig.json --noEmit",
    "build:solid": "vite build --config solid/vite.config.ts",
    "check": "bun run test && bun run test:solid && bun run typecheck:solid && bun run build:solid"
  },
  "dependencies": {
    "@automerge/automerge": "3.4.1",
    "openid-client": "6.8.7"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.4",
    "solid-js": "1.9.15",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14"
  }
}
