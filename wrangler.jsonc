{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calendar-sync",
  "main": "backend/cloudflare/worker.js",
  "compatibility_date": "2026-09-04",
  "durable_objects": {
    "bindings": [
      {
        "name": "CALENDAR_STATE",
        "class_name": "CalendarState"
      }
    ]
  },
  "exports": {
    "CalendarState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
